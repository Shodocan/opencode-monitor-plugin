{
  "name": "opencode-monitor-plugin",
  "version": "0.1.0",
  "description": "OpenCode background, monitor, loop, and schedule job plugin with TUI status indicator.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "background-jobs",
    "monitoring"
  ],
  "engines": {
    "node": ">=22",
    "opencode": ">=1.15.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@opencode-ai/plugin": "^1.15.12",
    "@opentui/solid": "^0.2.16",
    "solid-js": "^1.9.12",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": ""
}
